{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2020",
    "types": [
      "custom-functions-runtime",
      "office-js",
      "office-runtime"
    ],
    "lib": [
      "es2020",
      "dom"
    ]
  },
  "include": [
    "src"
  ]
}
